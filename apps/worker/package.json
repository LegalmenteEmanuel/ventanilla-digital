{
  "name": "@vd/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@vd/core": "workspace:*",
    "@vd/db": "workspace:*",
    "@vd/jobs": "workspace:*",
    "bullmq": "^5.34.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.2"
  }
}
