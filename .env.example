# --- Base de datos ---
DATABASE_URL="postgresql://vd:vd@localhost:5432/ventanilla?schema=public"

# --- Redis (colas de trabajos) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (Auth.js) ---
AUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
AUTH_URL="http://localhost:3000"

# URL pública usada en el QR de verificación de los PDF.
PUBLIC_BASE_URL="http://localhost:3000"

# --- Correo (Mailhog en desarrollo) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="no-reply@ventanilla.local"

# --- Firma digital ---
# Clave privada PEM usada para firmar los actos administrativos aprobados.
# En local se autogenera con `pnpm --filter @vd/db seed`.
SIGNING_PRIVATE_KEY_PATH="./.keys/signing.pem"
SIGNING_CERT_SUBJECT="CN=Ventanilla Digital (DEMO), O=Alcaldia Municipal Demo, C=HN"

# --- Almacenamiento de documentos ---
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"

# --- Worker ---
# Frecuencia del barrido de SLA vencidos (ms).
SLA_SCAN_EVERY_MS="900000"
